{{!
    Template para visualização de próprias solicitações.
    Strings passadas via PHP para evitar chaves duplas por cache desatualizado.
}}

<div class="">
    <nav class="mb-3 moremenu navigation observed">
        <ul class="nav nav-tabs">
            {{#filters}}
            <li class="nav-item">
                <a class="nav-link {{#active}}active{{/active}}" href="{{url}}">{{label}}</a>
            </li>
            {{/filters}}
        </ul>
    </nav>
</div>

<div id="page-content">

    <div id="region-main-box">
        <section id="region-main" class="p-4" style="background-color: transparent;">

            <div class="d-flex justify-content-between align-items-center m-4">
                <h4 class="mb-0">{{str_my_requests}}</h4>
                <a class="btn btn-primary" href="{{new_request_url}}">
                    + {{str_thankyou_new_request}}
                </a>
            </div>

            {{#can_manage}}
            <div class="m-2">
                <a href="{{config.wwwroot}}/local/solicitacoes/gerenciar.php" class="btn btn-primary">
                    {{str_access_all_requests}}
                </a>
            </div>
            {{/can_manage}}

            {{#has_requests}}
            <div class="table-responsive" style="background-color: #fff;">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>{{str_action_type}}</th>
                            <th>{{str_course}}</th>
                            <th>{{str_target_users}}</th>
                            <th>{{str_role}}</th>
                            <th>{{str_created_at}}</th>
                            <th>{{str_status}}</th>
                            <th>{{str_actions}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#requests}}
                        <tr>
                            <td>
                                <small class="text-muted" style="font-family:monospace; letter-spacing:.03em;">#{{request_id}}</small>
                                <div>{{acao_label}}</div>
                            </td>
                            <td>{{{cursos_display}}}</td>
                            <td>{{{usuarios_display}}}</td>
                            <td>{{papel_display}}</td>
                            <td>{{created_date}}</td>
                            <td>
                                <span class="badge {{status_badge_class}}">{{status_label}}</span>
                            </td>
                            <td>
                                <a href="{{view_url}}" class="btn btn-sm">{{str_view}}</a>
                            </td>
                        </tr>
                        {{/requests}}
                    </tbody>
                </table>
            </div>
            {{/has_requests}}

            {{^has_requests}}
            <div class="alert alert-info">
                <p>{{str_no_requests}}</p>
            </div>
            {{/has_requests}}

        </section>
    </div>
</div>
