{{!
    Template para gerenciamento de solicitações.
    Strings passadas via PHP para evitar chaves duplas por cache desatualizado.
}}

<div class="">
    <nav class="mb-3 moremenu navigation observed">
        <ul class="nav nav-tabs">
            {{#filters}}
            <li class="nav-item">
                <a class="nav-link {{#active}}active{{/active}}" href="{{url}}">{{label}}</a>
            </li>
            {{/filters}}
        </ul>
    </nav>
</div>

{{! Link Voltar }}
{{#back_url}}
<div class="mb-3">
    <a href="{{back_url}}" class="btn btn-secondary btn-sm">← {{str_back}}</a>
</div>
{{/back_url}}

<div id="page-content">
    <div id="region-main-box">
        <section id="region-main" class="p-4" style="background-color: transparent;">

            {{#has_requests}}

            {{! ── Paginação (topo) ── }}
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-2" style="gap:.5rem;">
                <small class="text-muted">{{paging_summary}}</small>
                <div>{{{paging_bar}}}</div>
            </div>

            <form id="sol-bulk-form" method="post" action="{{form_action_url}}">
                <input type="hidden" name="sesskey"  value="{{sesskey}}">
                <input type="hidden" name="filter"   value="{{current_filter}}">
                <input type="hidden" name="page"     value="{{current_page}}">
                <input type="hidden" name="action"   value="bulk_approve">

                {{! ── Barra de ação em massa ─────────────────────────────────── }}
                <div class="d-flex align-items-center mb-2" style="gap:.75rem; min-height:2.25rem;">
                    <button type="submit" id="sol-btn-bulk"
                            class="btn btn-success btn-sm"
                            disabled
                            style="white-space:nowrap;">
                        ✓ {{str_approve_selected}} (<span id="sol-sel-count">0</span>)
                    </button>
                    <small class="text-muted" id="sol-sel-hint">
                        {{str_bulk_hint}}
                    </small>
                </div>

                <div class="table-responsive" style="background-color: #fff;">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th style="width:2.5rem; vertical-align:middle; text-align:center;">
                                    <input type="checkbox" id="sol-select-all"
                                           title="{{str_select_all}}"
                                           style="cursor:pointer; width:1rem; height:1rem;">
                                </th>
                                <th>{{str_user}}</th>
                                <th>{{str_action_type}}</th>
                                <th>{{str_course}}</th>
                                <th>{{str_target_users}}</th>
                                <th>{{str_role}}</th>
                                <th>{{observacao_header}}</th>
                                <th>{{str_created_at}}</th>
                                <th>{{str_status}}</th>
                                <th>{{str_actions}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#requests}}
                            <tr>
                                <td style="vertical-align:middle; text-align:center;">
                                    {{#show_checkbox}}
                                    <input type="checkbox"
                                           class="sol-req-cb"
                                           name="selected_ids[]"
                                           value="{{request_id}}"
                                           style="cursor:pointer; width:1rem; height:1rem;">
                                    {{/show_checkbox}}
                                </td>
                                <td>{{{solicitante_link}}}</td>
                                <td>
                                    <small class="text-muted" style="font-family:monospace; letter-spacing:.03em;">#{{request_id}}</small>
                                    <div>{{acao_label}}</div>
                                </td>
                                <td>{{{cursos_display}}}</td>
                                <td>{{{usuarios_display}}}</td>
                                <td>{{papel_display}}</td>
                                <td>{{{observacao_display}}}</td>
                                <td>{{created_date}}</td>
                                <td>
                                    <span class="badge {{status_badge_class}}">{{status_label}}</span>
                                </td>
                                <td>
                                    {{#show_approve}}
                                    <a href="{{approve_url}}" class="btn btn-sm btn-primary">{{str_approve}}</a>
                                    {{/show_approve}}
                                    {{#show_reject}}
                                    <a href="{{reject_url}}" class="btn btn-sm">{{str_deny}}</a>
                                    {{/show_reject}}
                                    <a href="{{view_url}}" class="btn btn-sm">{{str_view}}</a>
                                    <a href="{{delete_url}}" class="btn btn-sm" onclick="return confirm('{{str_confirm_delete}}');">{{str_delete}}</a>
                                </td>
                            </tr>
                            {{/requests}}
                        </tbody>
                    </table>
                </div>
            </form>

            {{! ── Paginação (rodapé) ── }}
            <div class="mt-3">{{{paging_bar}}}</div>

            <script>
            (function () {
                'use strict';

                var form      = document.getElementById('sol-bulk-form');
                var selectAll = document.getElementById('sol-select-all');
                var btnBulk   = document.getElementById('sol-btn-bulk');
                var countEl   = document.getElementById('sol-sel-count');
                var hintEl    = document.getElementById('sol-sel-hint');

                if (!form || !selectAll) return;

                function getCbs()     { return form.querySelectorAll('.sol-req-cb'); }
                function getChecked() { return form.querySelectorAll('.sol-req-cb:checked'); }

                function updateUI() {
                    var total   = getCbs().length;
                    var checked = getChecked().length;

                    countEl.textContent = checked;
                    btnBulk.disabled    = (checked === 0);

                    hintEl.textContent = checked === 0
                        ? '{{str_bulk_hint}}'
                        : checked + ' solicitação(ões) selecionada(s)';

                    selectAll.indeterminate = (checked > 0 && checked < total);
                    selectAll.checked       = (total > 0 && checked === total);
                }

                selectAll.addEventListener('change', function () {
                    getCbs().forEach(function (cb) { cb.checked = selectAll.checked; });
                    updateUI();
                });

                form.addEventListener('change', function (e) {
                    if (e.target && e.target.classList.contains('sol-req-cb')) {
                        updateUI();
                    }
                });

                form.addEventListener('submit', function (e) {
                    var n = getChecked().length;
                    if (n === 0) { e.preventDefault(); return; }
                    if (!window.confirm('Aprovar ' + n + ' solicitação(ões) selecionada(s)?\n\nEsta ação não pode ser desfeita.')) {
                        e.preventDefault();
                    }
                });

                updateUI();
            }());
            </script>

            {{/has_requests}}

            {{^has_requests}}
            <p>{{str_no_requests}}</p>
            {{/has_requests}}

        </section>
    </div>
</div>
